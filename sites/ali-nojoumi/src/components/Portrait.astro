---
interface Props { alt: string; eager?: boolean }
const { alt, eager = false } = Astro.props;
const sizes = '(min-width: 1100px) 80vw, 118vw';
---
<picture>
  <source type="image/avif" srcset="/portrait/ali-994.avif 994w, /portrait/ali-1648.avif 1648w, /portrait/ali-2841.avif 2841w" sizes={sizes} />
  <source type="image/webp" srcset="/portrait/ali-994.webp 994w, /portrait/ali-1648.webp 1648w, /portrait/ali-2841.webp 2841w" sizes={sizes} />
  <img src="/portrait/ali-1648.webp" alt={alt} width="2841" height="2378" decoding={eager ? 'sync' : 'async'} fetchpriority={eager ? 'high' : 'auto'} />
</picture>
