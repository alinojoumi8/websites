---
// A two-page print sheet. scripts/dossier.mjs prints it to the PDF that the
// contact section offers. It holds only facts that are already on the site.
import '@fontsource-variable/syne';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import { cmor, education, figures, keywa, lab, languages, pontemesto, site, skills, ventures } from '../lib/content';

const fmt = (n: number) => n.toLocaleString('en-US');
const jobs = [
  { name: pontemesto.name, role: pontemesto.role, dates: pontemesto.dates, extra: pontemesto.link.label, lead: pontemesto.challenge, steps: pontemesto.steps, out: pontemesto.outcome },
  { name: `${keywa.name} (${keywa.aka})`, role: keywa.role, dates: keywa.dates, extra: keywa.note, lead: keywa.challenge, steps: keywa.steps, out: keywa.paper },
  { name: cmor.full, role: cmor.role, dates: cmor.dates, extra: '', lead: cmor.challenge, steps: cmor.steps, out: cmor.outcome },
];
const projects = [lab.manyworld, lab.triallens, lab.crowdlens];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Ali Nojoumi · Executive dossier</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <header class="top">
        <div>
          <svg class="mark" width="34" height="34" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <path d="M4 33 15.5 7 20 17.4" stroke="#b08d1e" stroke-width="3" stroke-linecap="square"></path>
            <path d="M9.6 24h8" stroke="#b08d1e" stroke-width="2.4" stroke-linecap="square"></path>
            <path d="M20 33V7l16 26V7" stroke="#10141c" stroke-width="3" stroke-linecap="square"></path>
          </svg>
          <h1>{site.name}</h1>
          <p class="role">Product leader · Payments, digital asset platforms and applied AI systems</p>
        </div>
        <ul class="reach">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.linkedin}>{site.linkedinLabel}</a></li>
          <li><a href={site.github}>{site.githubLabel}</a></li>
          <li>{site.location}</li>
        </ul>
      </header>

      <p class="line">{site.line}</p>
      <p class="sum">
        Fintech co-founder with hands-on experience in payment gateways, platform APIs and organizational crypto custody. Combines roadmap ownership
        with technical delivery. {site.open}
      </p>

      <ul class="figs">
        {
          figures.map((f) => (
            <li>
              <b>
                <span>{f.prefix}</span>
                {fmt(f.value)}
                {f.suffix}
              </b>
              <span>{f.label}</span>
              <i>{f.scope}</i>
            </li>
          ))
        }
      </ul>

      <h2>Ventures</h2>
      {
        jobs.map((j) => (
          <section class="job">
            <header>
              <h3>{j.name}</h3>
              <p>
                {j.role} · {j.dates}
                {j.extra && ` · ${j.extra}`}
              </p>
            </header>
            <p class="lead">{j.lead}</p>
            <ol>
              {j.steps.map((s) => (
                <li>
                  <b>{s.title}.</b> {s.text}
                </li>
              ))}
            </ol>
            <p class="out">{j.out}</p>
          </section>
        ))
      }

      <div class="cols">
        <section>
          <h2>Other ventures</h2>
          <ul class="list">
            {
              ventures.map((v) => (
                <li>
                  <b>{v.name}</b> <i>{v.role}, {v.dates}</i>
                  <span>{v.text}</span>
                </li>
              ))
            }
          </ul>
        </section>
        <section>
          <h2>Open-source projects</h2>
          <ul class="list">
            {
              projects.map((p) => (
                <li>
                  <b>{p.name}</b> <i>{p.repo}</i>
                  <span>{p.text}</span>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <div class="cols foot">
        <section>
          <h2>Core skills</h2>
          <p>{skills.map((s) => s.label).join(' · ')}</p>
        </section>
        <section>
          <h2>Education and languages</h2>
          <p>
            {education.map((e) => `${e.title}, ${e.where} (${e.when})`).join('. ')}.
            {' '}{languages.map((l) => `${l.name} (${l.level.toLowerCase()})`).join(', ')}.
          </p>
        </section>
      </div>
    </main>

    <style is:global>
      @page {
        size: Letter;
        margin: 13mm 15mm 12mm;
      }
      * {
        box-sizing: border-box;
      }
      html {
        background: #e9ecf1;
      }
      body {
        margin: 0;
        font: 400 9.4pt/1.42 'Inter Variable', Inter, system-ui, sans-serif;
        color: #10141c;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      main {
        max-width: 186mm;
        margin: 0 auto;
        padding: 12mm 0;
        background: #fff;
      }
      @media screen {
        main {
          padding: 14mm 15mm;
          margin: 10mm auto;
          box-shadow: 0 10px 40px rgb(0 0 0 / 0.15);
        }
      }
      @media print {
        html {
          background: #fff;
        }
        main {
          padding: 0;
          max-width: none;
        }
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      h1,
      h2,
      h3,
      p,
      ul,
      ol {
        margin: 0;
        padding: 0;
      }
      ul,
      ol {
        list-style: none;
      }
      .top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 10mm;
        padding-bottom: 4mm;
        border-bottom: 1.5pt solid #10141c;
      }
      .mark {
        display: block;
        margin-bottom: 3mm;
      }
      h1 {
        font: 700 25pt/0.95 'Syne Variable', Syne, sans-serif;
        letter-spacing: -0.03em;
      }
      .role {
        margin-top: 2.2mm;
        font-weight: 600;
        color: #7a5f10;
      }
      .reach {
        text-align: right;
        font: 500 7.6pt/1.55 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
        color: #2b3442;
      }
      .line {
        margin-top: 5mm;
        font: 600 13pt/1.3 'Inter Variable', Inter, sans-serif;
        max-width: 135mm;
      }
      .sum {
        margin-top: 2.5mm;
        max-width: 160mm;
        color: #2b3442;
      }
      .figs {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin: 5mm 0 1mm;
        border: 0.75pt solid #c5ccd6;
        border-radius: 0;
      }
      .figs li {
        padding: 3mm 3.4mm;
        border-left: 0.75pt solid #c5ccd6;
        display: grid;
        gap: 0.6mm;
      }
      .figs li:first-child {
        border-left: 0;
      }
      .figs b {
        font: 600 15pt/1 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
        letter-spacing: -0.03em;
      }
      .figs b span {
        font-size: 7.5pt;
        letter-spacing: 0;
        color: #7a5f10;
        margin-right: 0.8mm;
        vertical-align: 1.6mm;
      }
      .figs li > span {
        font-weight: 600;
        line-height: 1.25;
        margin-top: 1mm;
      }
      .figs i {
        font-style: normal;
        font-size: 8pt;
        color: #4a5565;
      }
      h2 {
        margin: 5.5mm 0 2mm;
        padding-bottom: 1.2mm;
        font: 700 11.5pt/1.1 'Syne Variable', Syne, sans-serif;
        letter-spacing: -0.01em;
        border-bottom: 0.75pt solid #b79526;
      }
      .job {
        break-inside: avoid;
        margin-top: 3.4mm;
      }
      .job header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 6mm;
      }
      h3 {
        font: 700 11pt/1.2 'Inter Variable', Inter, sans-serif;
      }
      .job header p {
        font-size: 8.4pt;
        color: #4a5565;
        text-align: right;
      }
      .lead {
        margin-top: 1mm;
        font-weight: 500;
      }
      .job ol {
        margin-top: 1.4mm;
        columns: 2;
        column-gap: 8mm;
        counter-reset: n;
      }
      .job ol li {
        break-inside: avoid;
        position: relative;
        padding-left: 5mm;
        margin-bottom: 1.1mm;
        color: #2b3442;
      }
      .job ol li::before {
        counter-increment: n;
        content: counter(n);
        position: absolute;
        left: 0;
        top: 0.1mm;
        font: 600 7.6pt/1.6 'JetBrains Mono Variable', monospace;
        color: #7a5f10;
      }
      .job ol b {
        color: #10141c;
      }
      .out {
        margin-top: 0.8mm;
        padding-left: 5mm;
        font-weight: 500;
      }
      .cols {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 8mm;
        break-inside: avoid;
      }
      .list li {
        margin-bottom: 1.8mm;
        break-inside: avoid;
      }
      .list i {
        font-style: normal;
        font-size: 8pt;
        color: #4a5565;
      }
      .list span {
        display: block;
        color: #2b3442;
      }
      .foot p {
        color: #2b3442;
      }
    </style>
  </body>
</html>
